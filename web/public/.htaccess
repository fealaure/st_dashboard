# Angular SPA fallback — qualquer rota desconhecida volta pro index.html
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Não reescrever arquivos/diretórios que existem
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tudo o mais cai no index.html
    RewriteRule ^ index.html [L]
</IfModule>

# Cache agressivo nos assets versionados (Angular já hashifica nomes)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

# index.html não pode ser cacheado (ele referencia os hashes novos)
<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
